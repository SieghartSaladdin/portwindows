datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

model Profile {
  id          String  @id @default("1")
  name        String
  title       String
  location    String
  email       String
  bio         String
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  phone       String?
  avatarUrl   String?
  resumeUrl   String?
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  tags        Json // Store as JSON array of strings
  githubUrl   String?
  liveUrl     String?
  images      Json     @default("[]") // Array of image URLs/paths
  featured    Boolean  @default(false) // Recommended project banner flag
  role        String?
  period      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Skill {
  id       String @id @default(uuid())
  category String
  skills   Json // Store as JSON array of strings
  order    Int    @default(0)
}

model Experience {
  id          String @id @default(uuid())
  role        String
  company     String
  duration    String
  description Json // Store as JSON array of strings
  order       Int    @default(0)
}

model Education {
  id          String  @id @default(uuid())
  institution String
  degree      String
  field       String?
  period      String
  description String?
  order       Int     @default(0)
}

model Certification {
  id            String  @id @default(uuid())
  name          String
  issuer        String
  date          String
  credentialUrl String?
  order         Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
