# =================================================================
# Aura OS - environment variables
# Local dev: copy to .env.local.   Docker compose: copy to .env
# Generate secrets with:  openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Never commit real values.
# =================================================================

# --- Database (PostgreSQL) ---------------------------------------
# Local development (Postgres on this machine):
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/portfolio_db?schema=public"
# docker-compose builds DATABASE_URL itself from these (URL-encode special characters in the password):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio_db
# Host port for the compose Postgres container (bound to 127.0.0.1)
POSTGRES_PORT=5433

# --- Developer Hub (admin) ---------------------------------------
# Login is disabled (503) until both are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required in production. In development a random per-process secret is used if empty.
JWT_SECRET=

# --- MCP server --------------------------------------------------
# Required for /api/mcp and `npm run mcp`; both refuse to run without a strong key
# (min. 16 characters; the old example key is rejected).
MCP_API_KEY=
MCP_PORT=3002

# --- AI companion (any OpenAI-compatible endpoint) --------------
# The chat returns 503 until an API key is set (except LLM_PROVIDER=ollama).
LLM_PROVIDER=openrouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Legacy fallback for LLM_API_KEY
OPENROUTER_API_KEY=
# Only for LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2

# --- Site --------------------------------------------------------
# Public URL, used for metadata, robots.txt and sitemap.xml (inlined at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where uploaded images / CV files are stored (default: <project>/uploads)
UPLOAD_DIR=
