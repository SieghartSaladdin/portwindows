# =================================================================
# Aura OS (PortWindows) - Environment Variables Configuration
# Copy this file to .env.local or set these variables in Docker Container
# =================================================================

# -----------------------------------------------------------------
# 🐘 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------
# For Local Development (PostgreSQL running on localhost):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# For Docker / Production Setup (replace postgres_container_name, user, password, db):
DATABASE_URL="postgresql://postgres:postgres@db:5432/portfolio_db?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_db

# -----------------------------------------------------------------
# 🔒 2. Developer Hub Admin Login Credentials
# -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_random_jwt_secret_key_change_me

# -----------------------------------------------------------------
# 🛠️ 3. MCP (Model Context Protocol) Admin Server Config
# -----------------------------------------------------------------
MCP_PORT=3002
MCP_API_KEY=mcp-sk-secretkey12345

# -----------------------------------------------------------------
# 🤖 4. AI Companion & OpenRouter / Custom LLM API Settings
# -----------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_API_BASE_URL=https://ai.rfieq.me/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=Combo_Secondary
OPENROUTER_API_KEY=your_openrouter_api_key_here
