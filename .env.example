# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env.local and configure your environment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM / AI CHAT PROVIDER CONFIGURATION
# Supported providers: 'openrouter' (default), '9router' / custom proxy, or 'ollama'
# ------------------------------------------------------------------------------
LLM_PROVIDER="openrouter"

# 1. Custom 9router / Custom OpenAI-compatible API Proxy Example
LLM_API_BASE_URL="https://ai.rfieq.me/v1"
LLM_API_KEY="your_9router_or_custom_api_key_here"
LLM_MODEL="Combo_Secondary"

# 2. OpenRouter.ai Default Fallback Example (Optional if using 9router)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"

# 3. Local Ollama Provider Example (Optional if LLM_PROVIDER="ollama")
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="gemma2"

# ------------------------------------------------------------------------------
# MCP SERVER API KEY AUTHENTICATION
# Required for authenticating SSE/HTTP requests to the MCP server endpoint
# ------------------------------------------------------------------------------
MCP_API_KEY="your_secure_mcp_api_key_here"

# ------------------------------------------------------------------------------
# DEVELOPER HUB / ADMIN DASHBOARD CREDENTIALS
# Used for authenticating into the /admin workspace
# ------------------------------------------------------------------------------
ADMIN_USERNAME="Doraemon"
ADMIN_PASSWORD="your_secure_admin_password_here"

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# PostgreSQL connection URL for Prisma ORM
# ------------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="portfolio_db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"
